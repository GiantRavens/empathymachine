[Unit]
Description=EmpathyMachine HTTP(S) inspecting proxy + DNS sinkhole
Documentation=https://github.com/GiantRavens/empathymachine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/notebook/code/empathymachine
ExecStart=%h/Desktop/notebook/code/empathymachine/target/release/empathymachine
Restart=on-failure
RestartSec=3
# Keep stderr/stdout in journal so `empathymachine logs` works
StandardOutput=journal
StandardError=journal
# Conservative resource hygiene; loosen if blocklist size grows
LimitNOFILE=65536
# Note: AmbientCapabilities=CAP_NET_BIND_SERVICE is intentionally NOT set —
# user services can't grant capabilities (would fail 218/CAPABILITIES).
# All default ports (8080/8081/8053) are >1024, so no capability is required.
# If you ever rebind to a low port, move this unit to /etc/systemd/system/
# and run it as a system service.

[Install]
WantedBy=default.target
